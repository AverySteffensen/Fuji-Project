{
  "name": "fuji-purchasing-operations",
  "main": "worker.ts",
  "compatibility_date": "2026-10-23",
  "triggers": { "crons": ["* * * * *"] },
  "kv_namespaces": [{ "binding": "STATE", "id": "REPLACE_WITH_OPERATIONS_KV_ID" }],
  "vars": { "APP_ORIGIN": "https://REPLACE_WITH_THE_NEW_APP_HOST" },
  "observability": { "enabled": true }
}
